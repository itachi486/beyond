{
  "name": "beyond",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "admin:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/setup-admin.mjs",
    "test:server": "node --test server/tests/*.test.mjs",
    "generate:cloudflare": "node cloudflare/generate-api.mjs",
    "test:cloudflare": "node --test cloudflare/tests/*.test.mjs"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "aws4fetch": "^1.0.20",
    "openai": "^7.45.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.35.5",
    "sql.js": "^1.15.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
