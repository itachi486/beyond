{
  // Separate, un-deployed preview. Never point this unfinished adapter at beyond.
  "name": "beyond-migration-preview",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "SUPABASE_CHARACTER_BUCKET": "beyond-character-assets" }
}
