      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://beyond.itach9279.workers.dev",
    "BEYOND_BACKEND_MODE": "supabase-admin-production",
    "SUPABASE_CHARACTER_BUCKET": "beyond-character-assets",
