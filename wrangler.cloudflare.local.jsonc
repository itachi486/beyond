{
  "name": "beyond-cloudflare-local",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beyond-migration-preview",
      "database_id": "5b21c5ee-c783-40a4-b5ec-6e086b1aa6ed",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://localhost:5190",
    "BEYOND_STAGE": "local",
    "TIGRIS_BUCKET_NAME": "beyond-preview",
    "TIGRIS_ENDPOINT": "https://t3.storage.dev"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ]
}
