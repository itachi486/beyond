# Optional local persistence path. Never commit the actual database.
BEYOND_DB_PATH=.local/beyond.sqlite
# Must exactly match the browser origin, including port.
APP_ORIGIN=http://localhost:5173
# Production requires NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# PORT=4173
# No initial administrator password belongs in this file. Use admin:setup stdin.

# Server-only OpenAI Images API. Put a real key in ignored .env.local, never VITE_*.
# OPENAI_API_KEY=
# AI_IMAGE_MODEL=gpt-image-2.5-sunburst
# AI_IMAGE_FREE_DAILY_LIMIT=3
# AI_IMAGE_PREMIUM_DAILY_LIMIT=20
# AI_IMAGE_DAILY_ATTEMPT_LIMIT=60
# Comma-separated EXISTING authenticated creator IDs assigned by the operator.
# AI_IMAGE_PREMIUM_CREATOR_IDS=

# Required server-only single administrator allowlist. Configure in ignored .env.local.
# Leave unset to deny ALL administrator access. Never prefix with VITE_.
# ADMIN_ALLOWED_EMAIL=

# Optional persistent character files directory, outside public/dist; default beside DB.
# BEYOND_ASSET_DIR=

# Supabase migration only: server secrets; never use VITE_ prefix.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-secret-or-legacy-service-role-key>
# SUPABASE_CHARACTER_BUCKET=beyond-character-assets

# Workers only: exact canonical HTTPS application origin, never trust request host.
# APP_ORIGIN=https://beyond.itach9279.workers.dev

# Optional Preview password-reset email delivery only. Signup does not require it. Never expose in VITE variables.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
